<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Dev builds only (sign-app.sh dev mode). Keep in sync with LocalFlow.entitlements. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- The self-signed "LocalFlow Dev" cert has no Team ID, so hardened-runtime library
         validation refuses to load the embedded whisper.framework and dyld aborts at launch.
         Never in release: verify-signing.sh rejects it in release mode. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
